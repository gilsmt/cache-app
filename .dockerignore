# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Git
.git
.gitignore

# IDE and editor
.vscode
.idea
.zed
*.swp
*.swo

# CI/CD and DevOps
.github
.devcontainer
.husky
docker-compose*.yml
Dockerfile*

# dependencies
node_modules
.pnp
.pnp.js
.bun

# next.js
.next/
out/
build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
backups

# local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Testing
coverage
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
__tests__
__mocks__
jest.config.*
vitest.config.*

# Build artifacts and caches
.vercel
*.tsbuildinfo
.swc
.turbo

# misc
.DS_Store
*.pem
Thumbs.db
tmp
temp
LICENSE
docs
