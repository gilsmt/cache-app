# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# Keep aligned with .dockerignore. Paths tracked here stay out of git; paths
# tracked in git but unneeded in the image live only in .dockerignore.

# dependencies (bun install)
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.bun

# output
.next
out
dist
build
*.tgz
prisma/client

# code coverage
coverage
*.lcov

# logs
*.log
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.plans

# dotenv environment variable files
.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# local
backups
.tmp
tmp
temp
.opencode
opencode.json

# caches
.eslintcache
.cache
.turbo

# typescript
*.tsbuildinfo
next-env.d.ts

# misc
.DS_Store
Thumbs.db
*.pem
.swc
*.swp
*.swo

# vercel
.vercel

# IntelliJ based IDEs
.idea
# .vscode and .zed hold shared settings and stay tracked.
