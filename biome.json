{
    "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
    "extends": [
        "ultracite/biome/core",
        "ultracite/biome/react",
        "ultracite/biome/next"
    ],
    "files": {
        "includes": [
            "!!**/extensions",
            "!!**/public",
            "!!**/prisma/client",
            "!!**/backups",
            "!!**/.agents",
            "!!**/.swc",
            "!!**/.well-known/workflow"
        ]
    },
    "formatter": { "indentWidth": 4 },
    "javascript": { "formatter": { "indentWidth": 4 } },
    "json": { "formatter": { "indentWidth": 4 } },
    "linter": {
        "rules": {
            "complexity": {
                "noExcessiveCognitiveComplexity": {
                    "level": "warn",
                    "options": { "maxAllowedComplexity": 45 }
                }
            },
            "performance": {
                "noBarrelFile": "off",
                "noImgElement": "off",
                "noNamespaceImport": "off",
                "noAwaitInLoops": "off"
            },
            "suspicious": {
                "noBitwiseOperators": "off",
                "noUnnecessaryConditions": "off",
                "useBaseline": "off"
            },
            "style": {
                "useDestructuring": "off",
                "useNamedCaptureGroup": "off"
            }
        }
    }
}
